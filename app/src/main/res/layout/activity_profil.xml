<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ActivityProfil">
    <TextView
        android:id="@+id/pu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="60dp"
        android:textSize="30dp"/>
    <TextView
        android:id="@+id/us"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/user"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pu"
        android:layout_marginTop="40dp"
        android:layout_marginStart="30dp"
        android:textSize="18dp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/resul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/res"
        app:layout_constraintStart_toStartOf="@id/us"
        app:layout_constraintTop_toBottomOf="@id/pu"
        android:layout_marginTop="40dp"
        android:layout_marginStart="100dp"
        android:textSize="18dp"/>
    <Button
        android:id="@+id/fb"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/us"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"
        android:text="@string/pf"
        android:layout_marginStart="90dp"
        android:layout_marginEnd="90dp"
        app:icon="@drawable/ic_linc" />
    <Button
        android:id="@+id/eme"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/fb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"
        android:text="@string/emm"
        android:layout_marginStart="90dp"
        android:layout_marginEnd="90dp"
        android:backgroundTint="@color/green"
        app:icon="@drawable/ic_mail" />
    <Button
        android:id="@+id/deco"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/eme"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"
        android:text="@string/dec"
        android:layout_marginStart="90dp"
        android:layout_marginEnd="90dp"
        android:backgroundTint="@color/red"
        app:icon="@drawable/ic_deco" />

        
        

</androidx.constraintlayout.widget.ConstraintLayout>